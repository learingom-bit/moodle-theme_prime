{{!
    @template theme_prime/destacado

    prime Destacado (highlighted/featured) block template.

    Renders a featured block with an optional image, title, description
    and call-to-action button, plus dynamic inline styles for margins,
    colors and background image.

    Context variables required for this template:
    * destacado - Array/flag wrapping the highlighted block content.
    * blockisempty - Flag indicating the block has content to render.
    * destacadomargin_bottom - Bottom margin in pixels for the block.
    * destacadomargin_top - Top margin in pixels for the block.
    * destacadomedia - URL of the highlighted block image/background.
    * destacadocolortitle - Text color for the title and paragraphs.
    * destacadocolorbg - Background color for the block.
    * destacadocontent - Flag indicating whether media + content should render.
    * destacadotitle - Title text of the highlighted block (HTML allowed).
    * destacadodesc - Description text of the highlighted block (HTML allowed).
    * btntext - Text for the call-to-action button.
    * buttonlink - URL the call-to-action button links to.
    * btntarget - Target attribute for the button link (e.g. "_self", "_blank").
    * btnclass - Extra CSS classes for the block wrapper.

    Example context (json):
    {
        "destacado": true,
        "blockisempty": true,
        "destacadomargin_bottom": 20,
        "destacadomargin_top": 20,
        "destacadomedia": "/theme/prime/pix/destacado.jpg",
        "destacadocolortitle": "#333333",
        "destacadocolorbg": "#f5f5f5",
        "destacadocontent": true,
        "destacadotitle": "Featured course",
        "destacadodesc": "<p>Discover our newest course offering.</p>",
        "btntext": "Learn more",
        "buttonlink": "/course/view.php?id=2",
        "btntarget": "_self",
        "btnclass": "custom-class"
    }
}}

<style>
.destacado-block{
    margin-bottom:{{destacadomargin_bottom}}px;
    margin-top:{{destacadomargin_top}}px;
}
.destacado-block-img{
    background-image:url({{destacadomedia}});
}
.destacado-block  h2, .destacado-block  p{
    color:{{destacadocolortitle}};
}
.destacado-block  h2, .destacado-block  .h2{
    color:{{destacadocolortitle}};
}
.destacado-block:before{
    display:none;
}

</style>
{{#destacado}}
    {{#blockisempty}}
        <div class="destacado-block p20  {{^destacadocontent}}destacado-btn-block{{/destacadocontent}} {{btnclass}}" style="background-color:{{destacadocolorbg}};" id="destacado" >
                <div class="container flex-container" >
                    {{#destacadocontent}}
                        <div class="destacado-block-imgs col-md-6">
                          <img src="{{destacadomedia}}">
                        </div>
                        <div class="p20 col-md-6" >
                            {{#destacadotitle}}<h5 class="titulo2">{{{destacadotitle}}}</h5>{{/destacadotitle}}
                            {{#destacadodesc}}<div  >{{{destacadodesc}}}</div>{{/destacadodesc}}
                            {{#btntext}}
                            <div class="btn-block pt20">
                                <a href="{{{buttonlink}}}" target="{{btntarget}}" class='btn btn-primary btn-circular'>
                                    {{{btntext}}}
                                </a>
                            </div>
                            {{/btntext}}
                        </div>
                    {{/destacadocontent}}
                    
                </div>
            </div>
    {{/blockisempty}}
{{/destacado}}

