{{!
    @template theme_prime/allcourses

    prime All columns layout template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
         "bodyattributes":""
    }
}}
{{#pcoursestatus}}

<style>
.prime-promoted-courses{
    background-image:url({{{promotedmedia}}});
}
</style>
<div class="prime-promoted-courses" id="prime-promoted-courses">
    <div class="container  content">
        <div class="container flex-container align-items-center pt50">
            <div class="col-md-6 wow  animate__zoomIn">
                <div class="titlebar section-titles">
                    {{#promotedtitle}}
                    <h2><b>{{{promotedtitle}}}</b></h2>
                    {{/promotedtitle}}
                </div>
            </div>
            <div class="col-md-6 wow  animate__zoomIn">
                {{#promotedcoursedesc}}
                <p >{{promotedcoursedesc}}</p>
                {{/promotedcoursedesc}}
                <a href="{{globalroot}}/courses/" class="btn btn-primary btn-circular">{{#str}}mycourses-text, theme_prime{{/str}}</a>
            </div>
        </div>

        <div class="prime-promoted-grid-container ">
            <div class="prime-promoted-carousel-wrapper" id="primePromotedCarouselWrapper">
                {{#allcursos}}
                <div class="prime-promoted-carousel-slide">
                    <div class="prime-promoted-card flex-container  wow  animate__zoomIn">
                        <div class="prime-promoted-pictures col-md-6" style="background-image:url({{{image}}});"></div>
                        <div class="prime-promoted-course-intro col-md-6">
                            <div class="prime-promoted-course-description flex-container">
                                <div class="prime-promoted-title_course lado1">
                                    <small class="prime-promoted-course_small">{{category_name}}</small>
                                    <h5><a href="{{{courseurl}}}">{{course_name}}</a></h5>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/allcursos}}
            </div>
        </div>

        <!-- Indicadores -->
        <div class="flex-container">
            <div class="prime-promoted-carousel-dots col-md-3" id="primePromotedCarouselDots"></div>
                <div class="col-md-2">
                    <button class="prime-promoted-carousel-btn prime-promoted-prev" onclick="primePromotedMoveCarousel(-1)"><i class="fa fa-angle-left"></i></button>
                    <button class="prime-promoted-carousel-btn prime-promoted-next" onclick="primePromotedMoveCarousel(1)"><i class="fa fa-angle-right"></i></button>
                </div>
            </div>
        </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('primePromotedCarouselWrapper');
    const slides = wrapper.querySelectorAll('.prime-promoted-carousel-slide');
    const totalSlides = slides.length;
    let currentIndex = 0;
    let slidesPerView = getSlidesPerView();

    // Crear dots
    const dotsContainer = document.getElementById('primePromotedCarouselDots');
    const totalDots = Math.ceil(totalSlides / slidesPerView);
    
    for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.className = 'prime-promoted-carousel-dot' + (i === 0 ? ' prime-promoted-active' : '');
        dot.setAttribute('data-index', i);
        dot.addEventListener('click', function() {
            primePromotedGoToSlide(parseInt(this.getAttribute('data-index')));
        });
        dotsContainer.appendChild(dot);
    }

    function getSlidesPerView() {
        if (window.innerWidth <= 900) return 1;
        return 2;
    }

    window.primePromotedMoveCarousel = function(direction) {
        const newIndex = currentIndex + direction;
        const maxIndex = Math.ceil(totalSlides / slidesPerView) - 1;
        
        if (newIndex < 0) {
            primePromotedGoToSlide(maxIndex);
        } else if (newIndex > maxIndex) {
            primePromotedGoToSlide(0);
        } else {
            primePromotedGoToSlide(newIndex);
        }
    };

    function primePromotedGoToSlide(index) {
        const maxIndex = Math.ceil(totalSlides / slidesPerView) - 1;
        currentIndex = Math.max(0, Math.min(index, maxIndex));
        
        const offset = currentIndex * (100 / slidesPerView);
        wrapper.style.transform = 'translateX(-' + offset + '%)';

        document.querySelectorAll('.prime-promoted-carousel-dot').forEach((dot, i) => {
            dot.classList.toggle('prime-promoted-active', i === currentIndex);
        });
    }

    let autoplayInterval;

    function startAutoplay() {
        stopAutoplay();
        autoplayInterval = setInterval(() => {
            window.primePromotedMoveCarousel(1);
        }, 5000);
    }

    function stopAutoplay() {
        if (autoplayInterval) {
            clearInterval(autoplayInterval);
            autoplayInterval = null;
        }
    }

    const container = document.querySelector('.prime-promoted-grid-container');
    container.addEventListener('mouseenter', stopAutoplay);
    container.addEventListener('mouseleave', startAutoplay);

    let resizeTimeout;
    window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
            slidesPerView = getSlidesPerView();
            const newTotalDots = Math.ceil(totalSlides / slidesPerView);
            const dots = document.querySelectorAll('.prime-promoted-carousel-dot');
            
            if (dots.length !== newTotalDots) {
                dotsContainer.innerHTML = '';
                for (let i = 0; i < newTotalDots; i++) {
                    const dot = document.createElement('button');
                    dot.className = 'prime-promoted-carousel-dot' + (i === currentIndex ? ' prime-promoted-active' : '');
                    dot.setAttribute('data-index', i);
                    dot.addEventListener('click', function() {
                        primePromotedGoToSlide(parseInt(this.getAttribute('data-index')));
                    });
                    dotsContainer.appendChild(dot);
                }
            }
            
            primePromotedGoToSlide(currentIndex);
        }, 250);
    });

    primePromotedGoToSlide(0);
    startAutoplay();
});
</script>
{{/pcoursestatus}}